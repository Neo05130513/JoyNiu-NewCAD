[Unit]
Description=Recover an interrupted JoyNiu CAD coordinated backup
After=docker.service
Requires=docker.service
Before=joyniu-cad-backup.service joyniu-cad-monitor.service

[Service]
Type=oneshot
User=root
UMask=0027
WorkingDirectory=/opt/joyniu-cad
ExecStart=/usr/bin/python3 /opt/joyniu-cad/deploy/commercial_operations.py recover --config /etc/joyniu-cad/operations.json
TimeoutStartSec=4min

[Install]
WantedBy=multi-user.target
