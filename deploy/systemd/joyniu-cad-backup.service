[Unit]
Description=JoyNiu CAD coordinated idle-only backup
After=docker.service joyniu-cad-recovery.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0027
WorkingDirectory=/opt/joyniu-cad
ExecStart=/usr/bin/python3 /opt/joyniu-cad/deploy/commercial_operations.py backup --config /etc/joyniu-cad/operations.json --execute
ExecStopPost=/usr/bin/python3 /opt/joyniu-cad/deploy/commercial_operations.py recover --config /etc/joyniu-cad/operations.json
TimeoutStartSec=45min
TimeoutStopSec=4min
