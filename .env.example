# Browser API endpoint. Keep real secrets on the FastAPI server.
VITE_API_BASE=http://localhost:8010/api/v1

# FastAPI platform service settings (copy to a server-side .env file).
# SQLite is intended for a single-node deployment; use a managed database and
# object storage when deploying multiple API workers.
JOYNIU_DB=./data/joyniu.sqlite3
# Replace with a random secret of at least 24 bytes.
JOYNIU_AUTH_SECRET=replace-with-a-random-secret-of-at-least-24-bytes
# fixture (deterministic acceptance profile) or tesseract (Pillow + binary).
JOYNIU_OCR_ENGINE=fixture
# Keep disabled in real deployments; only explicit fixture smoke tests enable it.
JOYNIU_ALLOW_UNVERIFIED_FIXTURE=0
# Comma-separated browser origins. Loopback ports are also allowed by default.
JOYNIU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional upload limit in bytes (default: 20 MiB).
JOYNIU_MAX_DRAWING_BYTES=20971520
# Server-side AI provider configuration. Never put this key in VITE_* or the
# browser bundle. Prefer a file with restrictive permissions in production.
# GPTX's documented OpenAI-compatible route is /v1 with the Responses wire API.
JOYNIU_AI_BASE_URL=https://gptx.shop/v1
JOYNIU_AI_API_KEY=
JOYNIU_AI_API_KEY_FILE=
# Clearer LLM aliases are accepted too. When both names are set, LLM_* is the
# canonical value for endpoint/model/reasoning; AI_* remains a legacy alias.
JOYNIU_LLM_BASE_URL=https://gptx.shop/v1
JOYNIU_LLM_MODEL=gpt-5.6-sol
JOYNIU_LLM_REASONING_EFFORT=high
JOYNIU_LLM_API_KEY_FILE=
# GPTX vision requests default to low detail for a bounded response time;
# use high/auto when the configured relay supports high-detail image decoding.
JOYNIU_AI_IMAGE_DETAIL=low
JOYNIU_AI_IMAGE_MAX_DIMENSION=1200
# Local customer demo only. Keep 0 in shared/production deployments; then a
# designer/admin bearer token is required for /api/v1/ai/conversation.
JOYNIU_AI_ALLOW_ANONYMOUS=0
# GPTX's documented Codex-compatible setup disables provider-side storage.
# Set 1 only when the relay explicitly supports stored previous_response_id turns.
JOYNIU_AI_STORE_RESPONSES=0
