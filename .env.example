# Browser API endpoint. Keep real secrets on the FastAPI server.
VITE_API_BASE=http://localhost:8010/api/v1

# FastAPI platform service settings (copy to a server-side .env file).
# SQLite is intended for a single-node deployment; use a managed database and
# object storage when deploying multiple API workers.
JOYNIU_DB=./data/joyniu.sqlite3
# Replace with a random secret of at least 24 bytes.
JOYNIU_AUTH_SECRET=replace-with-a-random-secret-of-at-least-24-bytes
# fixture (deterministic acceptance profile) or tesseract (Pillow + binary).
JOYNIU_OCR_ENGINE=fixture
# Keep disabled in real deployments; only explicit fixture smoke tests enable it.
JOYNIU_ALLOW_UNVERIFIED_FIXTURE=0
# Comma-separated browser origins. Loopback ports are also allowed by default.
JOYNIU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional upload limit in bytes (default: 20 MiB).
JOYNIU_MAX_DRAWING_BYTES=20971520
