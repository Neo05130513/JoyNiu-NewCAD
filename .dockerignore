# Keep build context to the API package, prebuilt frontend, and image configs.
**
!apps/
!apps/api/
!apps/api/pyproject.toml
!apps/api/README.md
!apps/api/app/
!apps/api/app/**
!deploy/
!deploy/Dockerfile.api
!deploy/Dockerfile.web
!deploy/Dockerfile.codex
!deploy/Dockerfile.commercial
!deploy/Dockerfile.currentcad
!deploy/install_codex.py
!deploy/Dockerfile.egress
!deploy/.cache/
!deploy/.cache/mihomo-v1.19.30.gz
!deploy/nginx.conf
!dist/
!dist/**

# Defensive exclusions also apply to the allowed directories above.
**/node_modules
**/.git
**/.env*
**/*.pem
**/*.key
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.venv
**/venv
**/data
**/artifacts
**/tests
**/*.test.*
deploy/.env.production
.DS_Store
**/.DS_Store
._*
**/._*
